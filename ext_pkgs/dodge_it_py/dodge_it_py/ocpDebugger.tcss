FieldSelectorScreen {
    align: center middle;
}

#field_selector_grid {
    width: 20;
    height: 20;
    border: thick $background 50%;
    background: $surface;
}

#field_label {
    column-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
}

Grid {
    grid-size:2;
}

Plotter {
    padding: 1 2;
}